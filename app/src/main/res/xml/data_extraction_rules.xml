<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: API keys (Google Maps, AI services) never leave the phone, in cloud backups or device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cardash_maps_key.xml" />
        <exclude domain="sharedpref" path="cardash_maps_key_fallback.xml" />
        <exclude domain="sharedpref" path="cardash_ai_keys.xml" />
        <exclude domain="sharedpref" path="cardash_ai_keys_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cardash_maps_key.xml" />
        <exclude domain="sharedpref" path="cardash_maps_key_fallback.xml" />
        <exclude domain="sharedpref" path="cardash_ai_keys.xml" />
        <exclude domain="sharedpref" path="cardash_ai_keys_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
